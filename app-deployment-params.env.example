# Shared schema for the manager+parser+chrome+db deployment env files consumed by
# page-parser-up.sh / page-parser-down.sh / watchers-manager-up.sh / watchers-manager-down.sh
# (the `$2` positional arg, default ../nas-prod-params.env).
#
# Copy this to a host/environment-specific file at the repo root, e.g.
# nas-prod-params.env, oracle-prod-params.env, oracle-test-params.env, oracle-dev-params.env,
# or a new deployment target, and fill in real values. Every such file shares this same
# key set — only names, ports, hosts, and credentials differ per target.
manager_name=auctions-manager
manager_port=8090

parser_name=auctions-page-parser
parser_host=localhost
parser_port=8190

chrome_name=auctions-chrome
chrome_host=localhost
chrome_port=4444
chrome_vnc_port=7900
chrome_max_sessions=2
chrome_image=selenium/standalone-chrome

db_name=postgresql
db_host=localhost
db_port=5432
db_user=postgres
db_password=CHANGEME  # <-- fill in a real password, do not deploy with this value
db_volume=auctions-data

api_user=watcher-user
api_password=CHANGEME  # <-- fill in a real password, do not deploy with this value
