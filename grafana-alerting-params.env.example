# Telegram bot used by Grafana's alerting contact point (see grafana-up.sh, which
# renders provisioning/alerting/contact-points.yaml from these values).
TELEGRAM_BOT_TOKEN=CHANGEME  # <-- fill in a real bot token, do not deploy with this value
TELEGRAM_CHAT_ID=CHANGEME  # <-- fill in a real chat id, do not deploy with this value
